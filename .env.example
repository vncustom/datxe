# === BẢN LOCAL (SQLite) — máy nội bộ ===
DATABASE_URL="file:./dev.db"
APP_TZ="Asia/Ho_Chi_Minh"
ORIGIN_NODE="local"
AUTH_SECRET="đổi-thành-chuỗi-ngẫu-nhiên-dài"

# === BẢN CLOUD (Vercel + Supabase) ===
# Đặt các biến này trong Vercel → Project Settings → Environment Variables.
# Xem docs/trien-khai.md để biết lấy chuỗi kết nối ở đâu.
#
# DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"
# AUTH_SECRET="chuỗi-ngẫu-nhiên-khác-với-bản-local"
# ORIGIN_NODE="cloud"
# APP_TZ="Asia/Ho_Chi_Minh"

# === SYNC DAEMON (M5) — chỉ đặt trên máy local ===
# SUPABASE_DB_URL="postgresql://USER:PASS@HOST:5432/postgres"
# SYNC_INTERVAL_SECONDS="20"
