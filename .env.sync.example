# Cấu hình cho Sync Engine daemon (chạy trên MÁY NỘI BỘ).
# Chép file này thành .env.sync và điền giá trị thật.

# Chuỗi Session pooler của Supabase (cổng 5432) — GIỐNG DIRECT_URL trên Vercel.
SUPABASE_DB_URL="postgresql://postgres.xxxx:MẬT_KHẨU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Đường dẫn file SQLite của bản nội bộ (mặc định prisma/dev.db).
# LOCAL_DB_PATH="G:\\apptulam\\datxe\\prisma\\dev.db"

# Chu kỳ đồng bộ, giây (mặc định 20).
# SYNC_INTERVAL_SECONDS="20"
